# Enforce consistent line endings across Windows, macOS, and Linux
* text=auto eol=lf

# Explicit text formats (scripts, motion templates, NLE exports, subtitles, docs)
*.py text eol=lf
*.sh text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.fcpxml text eol=lf
*.edl text eol=lf
*.srt text eol=lf
*.ass text eol=lf
*.vtt text eol=lf
*.cube text eol=lf

