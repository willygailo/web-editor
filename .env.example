# Optional: Anthropic Claude API Key (supports sk-ant-api03-* or sk-ant-usr-* keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_WORKSPACE_ID=

# Optional: Gemini Multimodal API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# Optional: Higgsfield Cloud API (https://cloud.higgsfield.ai/api-keys)
# Either set HF_KEY=key_id:key_secret OR set HF_API_KEY_ID and HF_API_KEY_SECRET separately
HF_KEY=
HF_API_KEY_ID=
HF_API_KEY_SECRET=
HF_DEFAULT_VIDEO_MODEL=kling

# Server Configuration
PORT=3001
HOST=0.0.0.0
STORAGE_DIR=./data
MAX_UPLOAD_MB=500

# Optional: Explicit FFmpeg / FFprobe paths (useful on Windows if not in PATH)
FFMPEG_PATH=
FFPROBE_PATH=
