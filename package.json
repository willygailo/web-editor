{
  "name": "cutflow-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @cutflow/shared build && pnpm --parallel --filter @cutflow/shared --filter @cutflow/server --filter @cutflow/web dev",
    "build": "pnpm --filter @cutflow/shared build && pnpm --filter @cutflow/server build && pnpm --filter @cutflow/web build",
    "test": "pnpm --filter @cutflow/shared test && pnpm --filter @cutflow/server test",
    "typecheck": "pnpm -r typecheck",
    "auto-edit": "python3 scripts/auto_edit.py",
    "auto-watch": "python3 scripts/auto_edit.py --watch",
    "ingest-url": "python3 scripts/ingest_url.py",
    "doctor": "python3 scripts/setup_connectors.py doctor",
    "connect-higgsfield": "python3 scripts/setup_connectors.py higgsfield",
    "plan-broll": "python3 scripts/plan_broll.py",
    "gen-broll": "python3 scripts/generate_broll.py"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
